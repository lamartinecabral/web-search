{
  "name": "@lamartinecabral/web-search",
  "version": "1.0.0",
  "description": "A Web Search tool for RAG workflows with multiple backend support.",
  "license": "ISC",
  "author": "lamartinecabral",
  "repository": {
    "url": "https://github.com/lamartinecabral/web-search"
  },
  "homepage": "https://github.com/lamartinecabral/web-search",
  "bugs": {
    "email": "lamartine.cb@gmail.com"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "lint": "npx -y biome check",
    "lint:fix": "npx -y biome check --write",
    "prepack": "npm run build",
    "tag": "v=$(node -p \"'v'+require('./package.json').version\") && git tag $v && git push origin $v",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lamartinecabral/extract-content": "0.0.7",
    "happy-dom": "20.14.5",
    "puppeteer-core": "25.10.0",
    "zod": "4"
  },
  "devDependencies": {
    "@types/node": "24",
    "typescript": "6.0.3"
  }
}
